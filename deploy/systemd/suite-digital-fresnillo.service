[Unit]
Description=Suite Digital Fresnillo Web
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/SuiteDigitalFresnilloWeb
Environment=SUITE_HOST=127.0.0.1
Environment=SUITE_PORT=8000
ExecStart=/var/www/SuiteDigitalFresnilloWeb/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

